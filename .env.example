# ============================================================
# CRYPTO LUCKY BLOG - Variables de Entorno
# ============================================================
# 1. Copia este archivo como .env.local
# 2. Rellena los valores reales
# 3. NUNCA subas .env.local a GitHub
# ============================================================

# --- NOTION ---
# Integration secret del workspace Notion. Obtener en: https://www.notion.so/my-integrations
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 📋 CryptoLucky Leads — base que ALIMENTA EL CRM de suscriptores.
# /api/subscribe crea aquí cada lead del formulario (Email, País, Fuente, Estado, Fecha).
# IMPRESCINDIBLE para la captación de emails: sin esta var, el formulario devuelve config_error.
NOTION_LEADS_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 📰 Artículos del Blog — base de PLANIFICACIÓN MANUAL (+ health-check en /api/notion-health).
# NO es la fuente de los artículos del sitio: los artículos publicados viven en
# `lib/articles-data.ts` (contenido estático en código). Editar esta base de Notion NO cambia la web.
NOTION_DATABASE_ID=f909b580-4099-4b53-8e75-d663dfa68223

# --- EMAIL (Resend) · usado por /api/subscribe para welcome + drip ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_NOTIFICATION_EMAIL=sirkokoloko007@gmail.com

# --- SITIO ---
NEXT_PUBLIC_SITE_URL=https://cryptolucky.vercel.app
NEXT_PUBLIC_SITE_NAME=CryptoLucky

# --- AFILIADOS (NO cambiar el codigo LUCKYSIRKO007) ---
NEXT_PUBLIC_BETFURY_AFFILIATE=https://betfury.io/?r=LUCKYSIRKO007

# --- ANALYTICS (definir en Vercel -> Settings -> Environment Variables) ---
# ID de medicion de Google Analytics 4 (crear propiedad en analytics.google.com)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Token de verificacion de Google Search Console (metodo "etiqueta HTML")
# NEXT_PUBLIC_GSC_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- REVALIDACION ISR ---
# Genera un token en: https://generate-secret.vercel.app/32
REVALIDATION_SECRET=tu_token_secreto_aqui
